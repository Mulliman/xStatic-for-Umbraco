<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContentTargetFolders>.</ContentTargetFolders>
    <Product>xStatic.AI</Product>
    <PackageId>xStatic.AI</PackageId>
    <Title>xStatic.AI</Title>
    <Version>19.0.0-alpha</Version>
    <Description>Optional AI add-on for xStatic for Umbraco 17+, providing Microsoft.Extensions.AI / Umbraco.AI Agent Tools and an AI Pre-Deploy GEO/SEO Audit post-generation action.</Description>
    <PackageTags>umbraco umbraco17 xstatic static site generation ai microsoft-extensions-ai umbraco-ai seo geo umbraco-marketplace</PackageTags>
    <Authors>Sam Mullins</Authors>
    <Company>Sam Mullins</Company>
    <Copyright>Sam Mullins</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Mulliman/xStatic-for-Umbraco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mulliman/xStatic-for-Umbraco</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageIconUrl />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Brand\Logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XStatic.Core\XStatic.Core.csproj" />
    <ProjectReference Include="..\XStatic\XStatic.csproj" />
  </ItemGroup>

</Project>
