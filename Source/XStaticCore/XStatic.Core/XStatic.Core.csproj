<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ContentTargetFolders>.</ContentTargetFolders>
    <Product>xStatic.Core</Product>
    <PackageId>xStatic.Core</PackageId>
    <Title>xStatic.Core</Title>
    <Version>19.0.0-alpha</Version>
    <Description>xStatic core libraries used for creating custom components to use with xStatic for Umbraco 18+.</Description>
    <PackageTags>umbraco umbraco18 xstatic static site generation</PackageTags>
    <Authors>Sam Mullins</Authors>
    <Copyright>Sam Mullins</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Mulliman/xStatic-for-Umbraco/wiki</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mulliman/xStatic-for-Umbraco</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageIconUrl />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" Version="19.0.0-rc1" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="19.0.0-rc1" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="19.0.0-rc1" />
	<PackageReference Include="Umbraco.Cms.Web.Website" Version="19.0.0-rc1" />
	<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Brand\Logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
