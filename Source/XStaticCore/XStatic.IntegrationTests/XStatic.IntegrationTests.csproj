<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Umbraco.Cms.Tests.Integration" Version="19.0.0-rc1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XStatic.Core\XStatic.Core.csproj" />
    <ProjectReference Include="..\XStatic\XStatic.csproj" />
    <ProjectReference Include="..\XStatic.Netlify\XStatic.Netlify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Tests.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Tests.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Tests.Local.json')" />
  </ItemGroup>

</Project>
