{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Umbraco.Cms.Tests": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "Tests": {
    "Database": {
      // "SQLite" (default, no setup needed) or "SqlServer"/"LocalDb".
      // Override per machine with appsettings.Tests.Local.json or env var Tests__Database__DatabaseType.
      "DatabaseType": "SQLite",
      "PrepareThreadCount": 4,
      "SchemaDatabaseCount": 4,
      "EmptyDatabasesCount": 2,
      "SQLServerMasterConnectionString": ""
    }
  }
}
