{
  "name": "assets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "generate": "openapi-ts --input http://localhost:23994/umbraco/openapi/xstatic-v1.json --output src/api --debug"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@umbraco-cms/backoffice": "^18.3.2",
    "@vitest/coverage-v8": "^5.1.1",
    "beautiful-mermaid": "^1.1.3",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "happy-dom": "^21.0.4",
    "marked": "^18.2.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "dompurify": "^3.4.18",
    "js-yaml": "^4.3.2"
  }
}
