{
  "name": "xstatic-mcp",
  "version": "1.0.0",
  "description": "Official Model Context Protocol (MCP) server for xStatic for Umbraco 17+ Management API",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xstatic-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "keywords": [
    "umbraco",
    "xstatic",
    "mcp",
    "model-context-protocol",
    "static-site-generator",
    "ai"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  }
}
